<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG：发布方式选择弹窗（按钮式） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/pm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[DEBUG] 选择发布方式"
        android:textColor="@color/mine_row_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pm_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="检测到异常，请选择替代发布方式："
        android:textColor="@color/mine_row_summary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/pm_btn_jpg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="① 转成 JPG 图片附件发送"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/pm_btn_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="② 竖排诗歌风格发送"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/pm_btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="取消"
        android:textAllCaps="false" />

</LinearLayout>
