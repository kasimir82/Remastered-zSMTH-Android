<?xml version="1.0" encoding="utf-8"?>
<!-- 回帖发送方式选择弹窗（正常/验证码图片/竖排） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bottom_sheet_bg"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="48dp">

    <TextView
        android:id="@+id/pm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择发布方式"
        android:textColor="@color/mine_row_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pm_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="如遇敏感词拦截，可选图片或竖排方式："
        android:textColor="@color/mine_row_summary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/pm_btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:text="取消"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/pm_btn_jpg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:text="转成验证码风格图片发送"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/pm_btn_vertical"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:text="竖排诗歌风格发送"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/pm_btn_random_symbols"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:text="随机填充字符发帖"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/pm_btn_normal"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:text="正常发送"
        android:textAllCaps="false" />

</LinearLayout>
