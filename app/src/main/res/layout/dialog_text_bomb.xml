<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/body_background_night"
    android:padding="16dp">

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/text_bomb_title"
      android:textColor="@color/status_text_night"
      android:textSize="@dimen/zsmth_font_size_large"
      android:textStyle="bold"
      android:paddingBottom="6dp" />

  <TextView
      android:id="@+id/text_bomb_hint"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textColor="@color/status_text_night"
      android:textSize="@dimen/zsmth_font_size_small"
      android:paddingBottom="10dp" />

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:maxHeight="360dp">

    <com.zfdang.zsmth_android.helpers.FlowLayout
        android:id="@+id/text_bomb_flow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp" />
  </ScrollView>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:paddingTop="12dp">

    <Button
        android:id="@+id/text_bomb_select_all"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/text_bomb_select_all"
        android:textSize="@dimen/zsmth_font_size_extra_small" />

    <Button
        android:id="@+id/text_bomb_clear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/text_bomb_clear"
        android:textSize="@dimen/zsmth_font_size_extra_small" />
  </LinearLayout>

  <Button
      android:id="@+id/text_bomb_copy"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/text_bomb_copy_selected" />
</LinearLayout>
