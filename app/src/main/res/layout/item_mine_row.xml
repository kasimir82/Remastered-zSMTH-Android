<?xml version="1.0" encoding="utf-8"?>
<!-- 「我的」页可点击行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mine_row_root"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@color/mine_row_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

  <ImageView
      android:id="@+id/mine_row_icon"
      android:layout_width="22dp"
      android:layout_height="22dp"
      android:contentDescription="@null"
      android:tint="@color/mine_icon_tint" />

  <TextView
      android:id="@+id/mine_row_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="14dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/mine_row_title"
      android:textSize="16sp" />

  <TextView
      android:id="@+id/mine_row_summary"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/mine_row_summary"
      android:textSize="13sp"
      android:visibility="gone" />

  <ImageView
      android:id="@+id/mine_row_chevron"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:layout_marginStart="2dp"
      android:contentDescription="@null"
      android:src="@drawable/ic_mine_chevron"
      android:tint="@color/mine_row_summary" />

</LinearLayout>
