<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/body_background_night"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/app_data_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:title="App数据管理"
        android:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/app_data_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="数据统计加载中..."
                android:textSize="14sp"
                android:textColor="@color/mine_row_title"
                android:lineSpacingExtra="4dp"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="导出为ZIP到 Download 目录，包含：应用设置(不含密码)、当前用户名、设备签名、本机黑名单、帖子时间缓存。zip内有manifest.json说明内容；恢复时手动选择该zip。"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                android:textColor="@color/mine_row_summary" />

            <Button
                android:id="@+id/btn_export"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="导出备份ZIP到 Download" />

            <Button
                android:id="@+id/btn_import"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="从ZIP文件恢复数据"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_clean"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="清除1个月前的时间缓存"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/app_data_db_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="时间缓存数据库：--"
                android:textSize="12sp"
                android:textColor="@color/mine_row_summary"
                android:gravity="center_horizontal"
                android:paddingTop="6dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
